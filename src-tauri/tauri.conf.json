{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OrgaLife",
  "version": "1.1.2",
  "identifier": "com.orgalife.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OrgaLife",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "shadow": true,
        "backgroundColor": "#0c0c0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "category": "Productivity"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQURBODAzQTY3RDQ2MzgKUldRNFJuMm1BNml0UTkvK2ovT0JZNEN6ZzU1ZFIxekZqZFQ3OFFGQkVwRHlyblRMTGlHeW9BNFcK",
      "endpoints": [
        "https://github.com/mgdev02/OrgaLife/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
