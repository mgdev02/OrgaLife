# OrgaLife — variables de entorno opcionales (copiar a .env.local si hace falta)
# No commitees archivos .env con valores reales.

# Build macOS sin certificado de Apple Developer (ya usado en package.json):
# TAURI_SKIP_SIGNING=true

# Solo si firmás releases o actualizador (NO subir estas claves al repo):
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
