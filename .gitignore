# =============================================================================
# OrgaLife — .gitignore para publicación en GitHub
# Se versionan: package-lock.json, src-tauri/Cargo.lock (apps reproducibles).
# =============================================================================

# Documentación local (no publicar)
ORGALIFE_CONTEXT.md

# NO se versionan: artefactos de build, dependencias, secretos ni target de Rust.
# =============================================================================

# --- Frontend (Node / Vite) ---
node_modules/
dist/
dist-ssr/
.eslintcache
*.tsbuildinfo
.vite/
coverage/

# --- Variables de entorno y secretos ---
.env
.env.*
!.env.example
*.local
*.pem
*.p12
*.pfx
*.cer
*.mobileprovision
*.key
*.password
*.secret
*.credentials
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# --- Tauri / Rust ---
src-tauri/target/
src-tauri/gen/schemas/
.tauri/
# Binarios locales (fuera de target, por si quedan copias sueltas)
src-tauri/**/*.exe
src-tauri/**/*.app
src-tauri/**/*.dmg

# Firmas y material de signing de Tauri (nunca subir)
src-tauri/sign-*
**/sign-*.key
**/sign-*.txt

# Legado Electron (por si reaparece tras builds viejos)
dist-electron/
release/
electron/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- macOS / Windows / Linux (sistema) ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Editores e IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Cachés y temporales ---
.cache/
.tmp/
temp/
tmp/
*.bak
*.orig

# --- Rust (cachés fuera de target, por herramientas) ---
**/*.rs.bk

.ORGALIFE_CONTEXT.md
